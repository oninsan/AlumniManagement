@model AlumniManagement.Models.AlumnusDetailsViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Alumnus</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Alumnus.FirstName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Alumnus.FirstName)
        </dd>
        <!-- Additional fields for Alumnus (like LastName, Username, etc.) -->
    </dl>
</div>

<h4>Employment History</h4>
<hr />
@if (Model.EmploymentHistory != null && Model.EmploymentHistory.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Company Name</th>
                <th>Job Title</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Job Description</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var employment in Model.EmploymentHistory)
            {
                <tr>
                    <td>@employment.CompanyName</td>
                    <td>@employment.Position</td>
                    <td>@employment.StartDate.ToString("yyyy-MM-dd")</td>
                    <td>@employment.EndDate?.ToString("yyyy-MM-dd")</td>
                    <td>@employment.JobDescription</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No employment history available.</p>
}

<div>
    <a asp-action="Edit" asp-route-id="@Model.Alumnus?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
