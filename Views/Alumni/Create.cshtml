@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


<script>
    const departmentCourseMapping = {
        "College of Teacher Education (CTE)": [
            "Bachelor of Elementary Education (BEED)",
            "Bachelor of Secondary Education Major in English (BSED - English)",
            "Bachelor of Secondary Education Major in Science (BSED - Science)",
            "Bachelor of Secondary Education Major in Mathematics (BSED - Math)",
            "Bachelor of Secondary Education Major in Filipino (BSED - Filipino)",
            "Bachelor of Secondary Education Major in Social Studies (BSED - SocSci)"
        ],
        "Psychology Department": [
            "Bachelor of Science in Psychology"
        ],
        "College of Business and Accountancy (CBA)": [
            "Bachelor of Science in Accountancy (BSA)",
            "Bachelor of Science in Accounting Technology (BSAT)",
            "Bachelor of Science in Business Administration (BSBA)"
        ],
        "College of Hospitality and Tourism Management (CHTM)": [
            "Bachelor of Science in Hospitality Management Major in General (BSHM-General)",
            "Bachelor of Science in Hospitality Management Major in Food and Beverage (BSHM-FB)",
            "Bachelor of Science in Tourism Management (BSTM)"
        ],
        "College of Computer Studies (CCS)": [
            "Bachelor of Science in Information Technology (BSIT)"
        ],
        "College of Criminal Justice Education (CCJE)": [
            "Bachelor of Science in Criminology (BSC)"
        ]
    };

    document.getElementById("departmentSelect").addEventListener("change", function () {
        const department = this.value;
        const courseSelect = document.getElementById("courseSelect");

        courseSelect.innerHTML = "";

        if (departmentCourseMapping[department]) {
            departmentCourseMapping[department].forEach(course => {
                const option = document.createElement("option");
                option.value = course;
                option.text = course;
                courseSelect.appendChild(option);
            });
        }
    });

    document.getElementById("departmentSelect").dispatchEvent(new Event("change"));
</script>