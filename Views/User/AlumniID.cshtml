<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@10"></script>
<script>

    $("#inputUsername").text(sessionStorage.getItem("firstName") + " " + sessionStorage.getItem("lastName"))
    $("#inputID").text("2024-" + sessionStorage.getItem("ID"))
    $("#inputCourseName").text(sessionStorage.getItem("courseGraduated"))
    $("#inputYearGraduated").text("Batch " + "(" + sessionStorage.getItem("yearGraduated") + ")")
    $("#inputMobile").text(sessionStorage.getItem("mobileNumber"))

    $("#inputDepartment").val(sessionStorage.getItem("department"))
    sessionStorage.getItem("workingStatus") === "true" ? $("#inputWorkingStatus").prop("checked", true) : $("#inputWorkingStatus").prop("checked", false)
    $("#inputWork").val(sessionStorage.getItem("currentWork"))

    $("#inputEmail").val(sessionStorage.getItem("email"))

    console.log($("#inputWorkingStatus").prop("checked"))

</script>