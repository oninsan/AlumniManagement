        <div class="col-xl-4 mx-auto">
            <!-- Account details card-->
            <div class="card mb-4 text-center">
                <div class="card-header fw-bold">Cebu Roosevelt Memorial Colleges</div>
                <div class="card-body">
                    <div class="fw-bold">San Vicente St., Bogo City, Cebu</div>
                    <br>
                    <div class="fw-bold" style="font-size: 1.25rem">Alumni Association, INC</div>
                    <div style="display: flex; justify-content: center;">
                        <img class="profile profile-header-img" src="/pic/profile.png" alt style="margin: auto;">
                    </div>

                    <form>
                        <!-- Form Group (username)-->
                        <div class="mb-3">

                            <div class="fw-bold" style="font-size: 3.25rem" id="inputUsername"></div>
                            <div class="fw-bold" style="font-size: 1.25rem" id="inputID"></div>
                            <br>
                            <div class="fw-bold" style="font-size: 2.25rem" id="inputCourseName"></div>
                            <div class="fw-bold" style="font-size: 2.25rem" id="inputYearGraduated"></div>
                            <br>
                            <div class="fw-bold" style="font-size: 2.25rem" id="inputMobile"></div>

                        </div>


                        <!-- Home button-->

                        <a asp-action="Index" class="btn btn-primary" type="button">Home</a>
                        <button class="btn btn-success" onclick="window.print()">Print</button>
                    </form>
                </div>
            </div>
